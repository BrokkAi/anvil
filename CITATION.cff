    website: "https://brokk.ai"
repository-code: "https://github.com/BrokkAi/anvil"
repository-artifact: "https://github.com/BrokkAi/anvil/releases"
url: "https://anvil.brokk.ai/"
license: LGPL-3.0-only
keywords:
  - coding agents
  - agent runtime
  - Agent Client Protocol
