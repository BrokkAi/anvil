---
import { LinkButton } from '@astrojs/starlight/components';
import type { StarlightRouteData } from '@astrojs/starlight/route-data';
import AnvilForge from './AnvilForge.astro';

const { data } = (Astro.locals as { starlightRoute: StarlightRouteData }).starlightRoute.entry;
const { actions = [] } = data.hero || {};
---

<section class="anvil-hero" aria-labelledby="_top">
  <div class="hero-copy">
    <p class="hero-kicker">
      <span aria-hidden="true"></span> Anvil by <a href="https://brokk.ai" rel="external">Brokk</a>
    </p>
    <h1 id="_top" data-page-title>
      One agent engine.<br />
      <em>Your interface.</em>
    </h1>
    <p class="hero-tagline">
      Anvil packages model routing, tools, permissions, and durable sessions into one replaceable
      process. Clients shape the experience; operators choose the executable.
    </p>

    {
      actions.length > 0 && (
        <div class="hero-actions">
          {actions.map(({ icon, link: href, text, variant }) => (
            <LinkButton href={href} variant={variant} icon={icon?.name}>
              {text}
              {icon?.html && <Fragment set:html={icon.html} />}
            </LinkButton>
          ))}
        </div>
      )
    }

    <aside class="install-panel anvil-panel anvil-panel--reverse" aria-labelledby="install-panel-title">
      <header class="install-panel__header">
        <a id="install-panel-title" href="install/">Install Anvil</a>
        <span>Choose an installation method</span>
      </header>
      <div class="install-panel__tabs" role="tablist" aria-label="Installation method">
        <button id="install-tab-curl" type="button" role="tab" aria-selected="true" aria-controls="install-panel-curl">Curl</button>
      </div>
      <div id="install-panel-curl" class="install-panel__command" role="tabpanel" aria-labelledby="install-tab-curl">
        <code>curl -fsSL https://raw.githubusercontent.com/BrokkAi/anvil/refs/heads/master/install.sh | bash</code>
        <button class="install-panel__copy" type="button" data-copy-install aria-label="Copy curl install command">
          <span data-copy-label>Copy</span>
        </button>
      </div>
    </aside>

    <ul class="hero-facts" aria-label="Anvil design principles">
      <li><span>Swappable</span><strong>Process, not library</strong></li>
      <li><span>Portable</span><strong>One executable</strong></li>
      <li><span>Open</span><strong>LGPL-3.0-only</strong></li>
    </ul>
  </div>

  <AnvilForge />

</section>

<script>
  const command = 'curl -fsSL https://raw.githubusercontent.com/BrokkAi/anvil/refs/heads/master/install.sh | bash';
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-install]');
  const copyLabel = copyButton?.querySelector<HTMLElement>('[data-copy-label]');

  copyButton?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(command);
      if (copyLabel) copyLabel.textContent = 'Copied';
      window.setTimeout(() => {
        if (copyLabel) copyLabel.textContent = 'Copy';
      }, 1600);
    } catch {
      if (copyLabel) copyLabel.textContent = 'Select command';
    }
  });
</script>

<style>
  @layer starlight.user {
    .anvil-hero {
      position: relative;
      isolation: isolate;
      display: grid;
      grid-template-columns: minmax(0, 1.02fr) minmax(28rem, 0.98fr);
      gap: clamp(var(--anvil-space-8), 5vw, var(--anvil-space-24));
      align-items: center;
      min-height: min(48rem, calc(100vh - var(--sl-nav-height)));
      padding:
        clamp(4.5rem, 9vw, 8rem)
        clamp(0rem, 2.2vw, var(--anvil-space-8))
        clamp(7rem, 12vw, 10rem);
      /*
       * Deliberately not clipped. The backdrop layers below bleed out of the content
       * column and up behind the header; clipping here would trap them. They are sized
       * to the viewport by --hero-bleed-*, so nothing can overflow the page.
       */
    }

    /*
     * --hero-bleed-* are measured and set by AnvilForge's layout(). The fallbacks keep
     * the grid inside the column for the frame before that script runs.
     */
    .anvil-hero::before {
      position: absolute;
      z-index: -2;
      inset:
        var(--hero-bleed-top, 0px)
        var(--hero-bleed-right, 0px)
        0
        var(--hero-bleed-left, 0px);
      background:
        linear-gradient(90deg, transparent 49.9%, var(--anvil-grid-strong) 50%, transparent 50.1%),
        linear-gradient(transparent 49.9%, var(--anvil-grid-strong) 50%, transparent 50.1%);
      background-size: 11rem 11rem;
      content: '';
      mask-image: linear-gradient(180deg, rgb(0 0 0 / 0.85), transparent 92%);
    }

    .hero-copy { position: relative; z-index: 2; }

    .hero-kicker {
      display: flex;
      align-items: center;
      gap: var(--anvil-space-3);
      margin: 0 0 var(--anvil-space-6);
      color: var(--anvil-muted);
      font-family: var(--anvil-font-mono);
      font-size: var(--anvil-text-sm);
      font-weight: var(--anvil-weight-bold);
      letter-spacing: var(--anvil-tracking-widest);
      text-transform: uppercase;
    }

    /* Matches the "<product> by Brokk" badge in the Bifrost and Mjolnir docs. */
    .hero-kicker > span {
      width: 0.5rem;
      height: 0.5rem;
      background: var(--anvil-cobalt);
      /* Softened rather than a full-strength glow, per the other accent marks here. */
      box-shadow: 0 0 14px color-mix(in srgb, var(--anvil-cobalt) 70%, transparent);
      transform: rotate(45deg);
    }

    .hero-kicker a {
      color: var(--anvil-ink);
      text-decoration-color: color-mix(in srgb, var(--anvil-ink) 38%, transparent);
      text-decoration-thickness: 1px;
      text-underline-offset: 0.2em;
      transition: color 140ms ease, text-decoration-color 140ms ease;
    }

    .hero-kicker a:hover,
    .hero-kicker a:focus-visible {
      color: var(--anvil-cobalt);
      text-decoration-color: currentColor;
    }

    .anvil-hero h1 {
      max-width: 13ch;
      margin: 0;
      color: var(--anvil-ink);
      font-family: var(--anvil-font-display);
      font-size: var(--anvil-text-display-hero);
      font-weight: var(--anvil-weight-regular);
      letter-spacing: var(--anvil-tracking-tightest);
      line-height: var(--anvil-leading-hero);
    }

    .anvil-hero h1 em {
      color: var(--anvil-cobalt);
      font-family: inherit;
      font-weight: inherit;
      letter-spacing: inherit;
    }

    .hero-tagline {
      max-width: 38rem;
      margin: var(--anvil-space-8) 0 0;
      color: var(--anvil-copy);
      font-size: var(--anvil-text-tagline);
      line-height: var(--anvil-leading-body);
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--anvil-space-3);
      margin-top: var(--anvil-space-8);
    }

    .hero-actions :global(.sl-link-button) {
      min-width: 9.5rem;
      justify-content: center;
      overflow: hidden;
      border-radius: 999rem;
      font-family: var(--anvil-font-mono);
      font-size: var(--anvil-text-sm);
      font-weight: var(--anvil-weight-bold);
      letter-spacing: var(--anvil-tracking-wider);
      text-transform: uppercase;
    }
    .hero-actions :global(.sl-link-button.secondary) {
      border-color: var(--anvil-line-strong);
      background: color-mix(in srgb, var(--anvil-surface-raised) 92%, transparent);
    }

    .hero-facts {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      max-width: 44rem;
      margin: calc(var(--anvil-space-12) + var(--anvil-space-2)) 0 0;
      padding: 0;
      border-block: 1px solid var(--anvil-line);
      list-style: none;
    }

    .hero-facts li {
      padding: var(--anvil-space-5) var(--anvil-space-4) var(--anvil-space-5) 0;
    }
    .hero-facts li + li {
      padding-inline-start: var(--anvil-space-5);
      border-inline-start: 1px solid var(--anvil-line);
    }
    .hero-facts span,
    .hero-facts strong { display: block; }
    .hero-facts span {
      margin-bottom: var(--anvil-space-2);
      color: var(--anvil-muted);
      font-family: var(--anvil-font-mono);
      font-size: var(--anvil-text-sm);
      letter-spacing: var(--anvil-tracking-widest);
      text-transform: uppercase;
    }
    .hero-facts strong {
      color: var(--anvil-ink);
      font-size: var(--anvil-text-xl);
      font-weight: var(--anvil-weight-semibold);
    }

    .install-panel {
      --install-command-surface: #1b242e;
      --install-command-border: rgb(238 241 244 / 0.18);
      --install-command-text: #eef1f4;
      width: 100%;
      max-width: 44rem;
      margin: var(--anvil-space-10) 0 0;
      color: var(--anvil-ink);
      background: var(--anvil-line-strong);
      font-family: var(--anvil-font-mono);
    }

    .install-panel::after {
      background: color-mix(in srgb, var(--anvil-surface-raised) 96%, transparent);
    }

    .install-panel__header {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--anvil-space-4);
      padding: var(--anvil-space-5) var(--anvil-space-6) var(--anvil-space-4);
    }

    .install-panel__header a {
      color: var(--anvil-ink);
      font-size: var(--anvil-text-lg);
      font-weight: var(--anvil-weight-bold);
      letter-spacing: var(--anvil-tracking-wider);
      text-decoration: none;
      text-transform: uppercase;
    }

    .install-panel__header span {
      color: var(--anvil-muted);
      font-size: var(--anvil-text-xs);
      letter-spacing: var(--anvil-tracking-wide);
      text-transform: uppercase;
    }

    .install-panel__tabs {
      position: relative;
      z-index: 1;
      display: flex;
      padding-inline: var(--anvil-space-6);
      border-top: 1px solid var(--anvil-line);
    }

    .install-panel__tabs button {
      padding: var(--anvil-space-3) var(--anvil-space-1) calc(var(--anvil-space-3) - 2px);
      border: 0;
      border-bottom: 2px solid var(--anvil-cobalt);
      background: transparent;
      color: var(--anvil-cobalt);
      cursor: default;
      font: inherit;
      font-size: var(--anvil-text-xs);
      font-weight: var(--anvil-weight-bold);
      letter-spacing: var(--anvil-tracking-widest);
      text-transform: uppercase;
    }

    .install-panel__command {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      border-top: 1px solid var(--install-command-border);
      background: var(--install-command-surface);
    }

    .install-panel__command code {
      display: block;
      min-width: 0;
      padding: var(--anvil-space-5) var(--anvil-space-6);
      overflow: hidden;
      color: var(--install-command-text);
      font-size: var(--anvil-text-base);
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .install-panel__copy {
      min-width: 6.5rem;
      padding: var(--anvil-space-4) var(--anvil-space-5);
      border: 0;
      border-inline-start: 1px solid var(--install-command-border);
      background: var(--install-command-surface);
      color: color-mix(in srgb, var(--anvil-cobalt) 72%, white);
      cursor: pointer;
      font: inherit;
      font-size: var(--anvil-text-xs);
      font-weight: var(--anvil-weight-bold);
      letter-spacing: var(--anvil-tracking-widest);
      text-transform: uppercase;
    }

    .install-panel__copy:hover,
    .install-panel__copy:focus-visible {
      background: color-mix(in srgb, var(--anvil-cobalt) 18%, transparent);
    }

    @media (width >= 62rem) {
      .install-panel {
        width: calc(196% + clamp(var(--anvil-space-8), 5vw, var(--anvil-space-24)));
        max-width: none;
      }
    }

    @media (width < 62rem) {
      .anvil-hero { grid-template-columns: 1fr; min-height: auto; padding-top: 4rem; }
      .hero-copy { max-width: 47rem; }
    }

    @media (width < 35rem) {
      .anvil-hero { padding-bottom: 6rem; }
      .anvil-hero h1 { font-size: var(--anvil-text-display-hero-sm); }
      .hero-facts { grid-template-columns: 1fr; }
      .hero-facts li + li { padding-inline-start: 0; border-inline-start: 0; border-top: 1px solid var(--anvil-line); }
      .install-panel__header {
        align-items: flex-start;
        flex-direction: column;
        gap: var(--anvil-space-2);
        padding: var(--anvil-space-4);
      }
      .install-panel__tabs { padding-inline: var(--anvil-space-4); }
      .install-panel__command { grid-template-columns: 1fr; }
      .install-panel__command code { padding: var(--anvil-space-4); }
      .install-panel__copy {
        width: 100%;
        min-height: 2.75rem;
        border-top: 1px solid var(--install-command-border);
        border-inline-start: 0;
        text-align: start;
      }
    }
  }
</style>
